{
	"$schema": "./node_modules/wrangler/config-schema.json",

	"name": "nanami-website",

	"compatibility_date": "2026-08-21",

	"compatibility_flags": [
		"nodejs_compat"
	],

	"main": ".svelte-kit/cloudflare/_worker.js",

	"keep_vars": true,

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"enabled": true
	}
}